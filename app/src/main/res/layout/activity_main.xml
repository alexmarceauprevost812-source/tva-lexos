<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- ==================== Contenu principal ==================== -->
    <FrameLayout
        android:id="@+id/racineContenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">

    <!-- Fond d'ecran : plein ecran, derriere les barres systeme -->
    <ImageView
        android:id="@+id/fondEcran"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_marceau" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/chatContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_max="840dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@android:color/transparent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:title="@string/app_name"
            android:titleTextColor="@color/orange"
            app:titleCentered="true"
            app:navigationIcon="@drawable/ic_menu_24">

            <!-- Les yeux de démon, toujours vivants dans la barre du haut -->
            <com.codexlocal.YeuxDemon
                android:id="@+id/yeuxBarre"
                android:layout_width="52dp"
                android:layout_height="30dp"
                android:layout_gravity="start|center_vertical" />

            <!-- Avatar (APK perso) : initiale du prénom, ouvre le profil et les réglages -->
            <FrameLayout
                android:id="@+id/avatarBoite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/avatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_rond_sombre"
                    android:contentDescription="Profil et réglages"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/avatarPastille"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_rond_sombre" />
            </FrameLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <View
            android:id="@+id/ligneHaut"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Equipe d'IA : ce que chaque role fait, en direct. -->
        <LinearLayout
            android:id="@+id/panneauEquipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_equipe_panneau"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/equipeEtape1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:paddingVertical="6dp"
                android:textColor="@color/grey"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/equipeEtape2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:paddingVertical="6dp"
                android:textColor="@color/grey"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/equipeEtape3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:paddingVertical="6dp"
                android:textColor="@color/grey"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/equipeEtape4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:paddingVertical="6dp"
                android:textColor="@color/grey"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/equipeEtape5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:paddingVertical="6dp"
                android:textColor="@color/grey"
                android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/equipeActivite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="start"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/equipeChrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/grey"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_raised"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="@string/status_init"
            android:textColor="@color/grey"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp">

                <!-- Les deux yeux de démon orange : brillent et clignent -->
                <com.codexlocal.YeuxDemon
                    android:id="@+id/logoAccueil"
                    android:layout_width="220dp"
                    android:layout_height="96dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:letterSpacing="0.06"
                    android:text="@string/app_name"
                    android:textColor="@color/orange"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/empty_subtitle"
                    android:textColor="@color/grey"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="@string/empty_hint"
                    android:textColor="@color/grey_dark"
                    android:textSize="12sp" />
            </LinearLayout>
            </ScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/messages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="8dp"
                android:scrollbars="vertical" />
        </FrameLayout>

        <View
            android:id="@+id/ligneBas"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Zone de saisie : grande boîte arrondie, texte en haut, ＋ et envoyer en bas -->
        <LinearLayout
            android:id="@+id/boiteSaisie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_composer_perso"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/hint_input"
                android:imeOptions="actionNone"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6"
                android:minHeight="52dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:textColor="@color/white"
                android:textColorHint="@color/grey"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- ＋ : ajouter une image ou un fichier -->
                <TextView
                    android:id="@+id/btnPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_rond_sombre"
                    android:clickable="true"
                    android:contentDescription="@string/plus_description"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="＋"
                    android:textColor="@color/white"
                    android:textSize="26sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/send"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:contentDescription="@string/send"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_send_circle"
                    android:tint="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Barre d'onglets du bas (APK perso) -->
        <View
            android:id="@+id/ligneOnglets"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/barreOnglets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- ==================== Tiroir gauche ==================== -->
    <LinearLayout
        android:id="@+id/tiroir"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/black"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <com.codexlocal.YeuxDemon
                android:id="@+id/yeuxTiroir"
                android:layout_width="56dp"
                android:layout_height="26dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nomTiroir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/app_name"
                    android:textColor="@color/orange"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/titreTiroir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/drawer_sous_titre"
                    android:textColor="@color/grey"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listeTiroir"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="20dp" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
